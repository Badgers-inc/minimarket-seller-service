<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="5" author="ekaterina">
        <createTable tableName="offer" schemaName="seller_application">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="product_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_offer_product"
                             referencedTableSchemaName="seller_application"
                             referencedTableName="product"
                             referencedColumnNames="id"/>
            </column>
            <column name="seller_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_offer_seller"
                             referencedTableSchemaName="seller_application"
                             referencedTableName="seller"
                             referencedColumnNames="id"/>
            </column>
            <column name="price" type="numeric(10, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz"/>
            <column name="active" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_offer_product_seller_unique"
                     tableName="offer"
                     schemaName="seller_application"
                     unique="true">
            <column name="product_id"/>
            <column name="seller_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>