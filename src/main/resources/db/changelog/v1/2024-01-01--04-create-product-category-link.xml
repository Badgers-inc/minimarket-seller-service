<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="4" author="ekaterina">
        <createTable tableName="product_product_category" schemaName="seller_application">
            <column name="product_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_link_product"
                             referencedTableName="product"
                             referencedColumnNames="id"
                             referencedTableSchemaName="seller_application"/>
            </column>
            <column name="category_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_link_category"
                             referencedTableName="product_category"
                             referencedColumnNames="id"
                             referencedTableSchemaName="seller_application"/>
            </column>
        </createTable>
        <addPrimaryKey columnNames="product_id, category_id"
                       constraintName="pk_product_category_link"
                       tableName="product_product_category"
                       schemaName="seller_application"/>
    </changeSet>
</databaseChangeLog>