<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="2" author="ekaterina">
        <createTable tableName="product_category" schemaName="seller_application" remarks="Категории товаров">
            <column name="id" type="bigint" autoIncrement="true" remarks="Идентификатор, генерируется">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="description" type="varchar(70)" remarks="Описание категории">
                <constraints nullable="false"/>
            </column>
            <column name="category_code" type="varchar(20)" remarks="Код категории">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="active" type="boolean" remarks="Активна ли запись">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="product_category" schemaName="seller_application">
            <column name="description" value="Пищевые товары"/>
            <column name="category_code" value="FOOD_PRODUCTS"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="product_category" schemaName="seller_application">
            <column name="description" value="Непищевые товары"/>
            <column name="category_code" value="NON-FOOD_PRODUCTS"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="product_category" schemaName="seller_application">
            <column name="description" value="Товары с возрастным ограничением"/>
            <column name="category_code" value="FOR_ADULTS"/>
            <column name="active" valueBoolean="true"/>
        </insert>
        <insert tableName="product_category" schemaName="seller_application">
            <column name="description" value="Электротехника"/>
            <column name="category_code" value="ELECTRICAL_APPLIANCE"/>
            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>
</databaseChangeLog>